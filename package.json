{
  "name": "apex-one",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/runPostgresMigrations.ts",
    "test:postgres": "tsx scripts/runPostgresPersistenceTests.ts",
    "test:redis": "tsx scripts/runRedisAuthStateTests.ts",
    "test:s3": "tsx scripts/runS3DocumentStorageTests.ts",
    "test:search": "tsx scripts/runPostgresSearchIndexTests.ts",
    "test:composition": "tsx scripts/runProductionCompositionTests.ts",
    "test:infrastructure": "tsx scripts/checkInfrastructureBoundary.ts",
    "test:security": "bun run test:infrastructure && tsx scripts/runSecurityTests.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.408.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  }
}
