# Application environment
# Set APP_ENV=production only when all Stage 4 durable adapters are implemented,
# configured, and wired. Production traffic fails closed otherwise.
APP_ENV=development

# Stage 11 immutable release identity. Production readiness requires these to
# identify the exact deployed artifact without exposing registry credentials.
APEX_DEPLOYMENT_ENVIRONMENT=
APEX_RELEASE_ID=
APEX_COMMIT_SHA=
APEX_IMAGE_DIGEST=

# Gemini API Key for Server-Side AI Intelligence
GEMINI_API_KEY=

# Stage 4 infrastructure providers
# Development/test may use memory. Production requires the durable provider shown.
APEX_DATABASE_ADAPTER=memory
APEX_SESSION_ADAPTER=memory
APEX_RATE_LIMIT_ADAPTER=memory
APEX_AUDIT_ADAPTER=memory
APEX_OBJECT_STORAGE_ADAPTER=memory
APEX_SEARCH_INDEX_ADAPTER=memory

# Durable PostgreSQL authority for database, audit, and search-index adapters.
# Production MUST use TLS, for example:
# DATABASE_URL=postgres://user:password@db.example:5432/apex?sslmode=require
DATABASE_URL=

# Durable Redis authority for authenticated sessions and distributed rate limits.
# Use a dedicated Redis database/cluster. Session tokens are stored only as
# SHA-256 key digests; raw opaque tokens and passwords are not persisted.
# rediss:// is supported for TLS-enabled production Redis endpoints.
# REDIS_URL=rediss://user:password@redis.example:6380/0
REDIS_URL=

# Durable S3-compatible document object storage.
# AWS S3 can leave S3_ENDPOINT empty; S3-compatible providers may set an HTTPS endpoint.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Base64-encoded 32-byte application encryption key used for client-side
# AES-256-GCM document encryption before ciphertext is sent to object storage.
# Generate out of band, for example: openssl rand -base64 32
DOCUMENT_STORAGE_ENCRYPTION_KEY=

# Stage 11 provider-neutral release controller. Configure these as protected
# deployment-environment secrets in CI; do not commit real values here.
APEX_DEPLOYMENT_CONTROL_URL=
APEX_DEPLOYMENT_CONTROL_TOKEN=
