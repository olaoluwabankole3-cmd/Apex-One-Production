# APEX ONE environment template
# See docs/ENVIRONMENT.md and docs/INFRASTRUCTURE-CONNECTION.md.
# Never commit real credentials.
#
# Phase 3 policy:
# - normal application development uses durable PostgreSQL/Redis/S3 providers;
# - in-memory adapters remain available only for isolated automated/unit tests.

APP_ENV=development
DEMO_MODE=false

# Immutable release identity.
# Required only when APP_ENV=production.
APEX_DEPLOYMENT_ENVIRONMENT=
APEX_RELEASE_ID=
APEX_COMMIT_SHA=
APEX_IMAGE_DIGEST=

# Server-side Google Gemini credential.
GEMINI_API_KEY=

# Durable provider selection.
APEX_DATABASE_ADAPTER=postgres
APEX_SESSION_ADAPTER=redis
APEX_RATE_LIMIT_ADAPTER=redis
APEX_AUDIT_ADAPTER=postgres
APEX_OBJECT_STORAGE_ADAPTER=s3
APEX_SEARCH_INDEX_ADAPTER=postgres

# PostgreSQL authority for application data, audit, and document search.
# Local durable development may use sslmode=disable.
# Staging/production require sslmode=require or sslmode=verify-full.
DATABASE_URL=

# Redis authority for sessions and distributed rate limits.
# Local durable development may use redis://.
# Staging/production require rediss://.
REDIS_URL=

# S3-compatible encrypted document object storage.
# AWS S3 may leave S3_ENDPOINT empty.
# Custom staging/production endpoints must use HTTPS.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Standard base64 encoding of exactly 32 random bytes.
# Used for AES-256-GCM encryption before document ciphertext is written to S3.
DOCUMENT_STORAGE_ENCRYPTION_KEY=

# Provider-neutral release controller.
APEX_DEPLOYMENT_CONTROL_URL=
APEX_DEPLOYMENT_CONTROL_TOKEN=

# One-time initial organization/administrator bootstrap.
# Do not leave APEX_BOOTSTRAP_CONFIRM or the password populated after bootstrap.
APEX_BOOTSTRAP_CONFIRM=
APEX_BOOTSTRAP_ORG_NAME=
APEX_BOOTSTRAP_ORG_DISPLAY_NAME=
APEX_BOOTSTRAP_ORG_SLUG=
APEX_BOOTSTRAP_ORG_INDUSTRY=
APEX_BOOTSTRAP_ORG_CURRENCY=
APEX_BOOTSTRAP_ORG_CURRENCY_SYMBOL=
APEX_BOOTSTRAP_ORG_TIMEZONE=
APEX_BOOTSTRAP_ADMIN_EMAIL=
APEX_BOOTSTRAP_ADMIN_USERNAME=
APEX_BOOTSTRAP_ADMIN_NAME=
APEX_BOOTSTRAP_ADMIN_TITLE=Administrator
APEX_BOOTSTRAP_ADMIN_PASSWORD=
