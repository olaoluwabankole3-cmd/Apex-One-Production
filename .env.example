# APEX ONE environment template
# See docs/ENVIRONMENT.md for the complete contract and production requirements.
# Never commit real credentials.

# Application mode.
# Production is fail-closed unless all durable providers, secure transports,
# audit controls, and immutable release-identity fields are valid.
APP_ENV=development

# Explicit development-only demo authentication.
# The security layer disables demo authentication whenever NODE_ENV=production
# or APP_ENV=production, even if this value is true.
DEMO_MODE=false

# Immutable release identity.
# Required in production. APEX_DEPLOYMENT_ENVIRONMENT must be staging or production;
# APEX_COMMIT_SHA must be a full 40-character Git SHA; APEX_IMAGE_DIGEST must be
# an immutable sha256 digest.
APEX_DEPLOYMENT_ENVIRONMENT=
APEX_RELEASE_ID=
APEX_COMMIT_SHA=
APEX_IMAGE_DIGEST=

# Server-side Google Gemini credential.
# Required when the Gemini-backed AI generation path is used.
GEMINI_API_KEY=

# Infrastructure providers.
# Memory providers are for development/test only. Production requires:
# database=postgres, session=redis, rate-limit=redis, audit=postgres,
# object-storage=s3, search-index=postgres.
APEX_DATABASE_ADAPTER=memory
APEX_SESSION_ADAPTER=memory
APEX_RATE_LIMIT_ADAPTER=memory
APEX_AUDIT_ADAPTER=memory
APEX_OBJECT_STORAGE_ADAPTER=memory
APEX_SEARCH_INDEX_ADAPTER=memory

# PostgreSQL authority for database, audit, and document-search providers.
# Production requires TLS with sslmode=require or sslmode=verify-full.
# Example:
# DATABASE_URL=postgres://user:password@db.example:5432/apex?sslmode=require
DATABASE_URL=

# Redis authority for authenticated sessions and distributed rate limits.
# Production requires rediss://.
# Example:
# REDIS_URL=rediss://user:password@redis.example:6380/0
REDIS_URL=

# S3-compatible encrypted document object storage.
# AWS S3 may leave S3_ENDPOINT empty. A custom production endpoint must use HTTPS.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Standard base64 encoding of exactly 32 random bytes.
# Used for AES-256-GCM document encryption before ciphertext is stored.
# Generate out of band, for example: openssl rand -base64 32
DOCUMENT_STORAGE_ENCRYPTION_KEY=

# Provider-neutral release controller.
# These belong in protected deployment-environment secrets for release control;
# they are not normal application business-data configuration.
APEX_DEPLOYMENT_CONTROL_URL=
APEX_DEPLOYMENT_CONTROL_TOKEN=
