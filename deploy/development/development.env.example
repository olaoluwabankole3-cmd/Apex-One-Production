# APEX ONE — durable local development profile
# Copy to deploy/development/development.env. The copied file is ignored by Git.
# Replace every placeholder before starting the stack.

APP_ENV=development
DEMO_MODE=false

APEX_DATABASE_ADAPTER=postgres
APEX_SESSION_ADAPTER=redis
APEX_RATE_LIMIT_ADAPTER=redis
APEX_AUDIT_ADAPTER=postgres
APEX_OBJECT_STORAGE_ADAPTER=s3
APEX_SEARCH_INDEX_ADAPTER=postgres

APEX_DEV_POSTGRES_USER=apex
APEX_DEV_POSTGRES_PASSWORD=replace-with-local-postgres-password
APEX_DEV_POSTGRES_DB=apex_development
APEX_DEV_POSTGRES_PORT=5432
DATABASE_URL=postgres://apex:replace-with-local-postgres-password@127.0.0.1:5432/apex_development?sslmode=disable

APEX_DEV_REDIS_PASSWORD=replace-with-local-redis-password
APEX_DEV_REDIS_PORT=6379
REDIS_URL=redis://:replace-with-local-redis-password@127.0.0.1:6379/0

APEX_DEV_S3_ACCESS_KEY_ID=replace-with-local-access-key
APEX_DEV_S3_SECRET_ACCESS_KEY=replace-with-local-secret-key
APEX_DEV_S3_BUCKET=apex-development-documents
APEX_DEV_S3_REGION=us-east-1
APEX_DEV_S3_PORT=4566
S3_ENDPOINT=http://127.0.0.1:4566
S3_BUCKET=apex-development-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret-key

# Generate with: openssl rand -base64 32
DOCUMENT_STORAGE_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Server-side only. Obtain from the configured Gemini project.
GEMINI_API_KEY=

# Initial organization/admin bootstrap. Used only by bun run infra:bootstrap-admin.
APEX_BOOTSTRAP_CONFIRM=
APEX_BOOTSTRAP_ORG_NAME=
APEX_BOOTSTRAP_ORG_DISPLAY_NAME=
APEX_BOOTSTRAP_ORG_SLUG=
APEX_BOOTSTRAP_ORG_INDUSTRY=
APEX_BOOTSTRAP_ORG_CURRENCY=USD
APEX_BOOTSTRAP_ORG_CURRENCY_SYMBOL=$
APEX_BOOTSTRAP_ORG_TIMEZONE=UTC
APEX_BOOTSTRAP_ADMIN_EMAIL=
APEX_BOOTSTRAP_ADMIN_USERNAME=
APEX_BOOTSTRAP_ADMIN_NAME=
APEX_BOOTSTRAP_ADMIN_TITLE=Administrator
APEX_BOOTSTRAP_ADMIN_PASSWORD=
