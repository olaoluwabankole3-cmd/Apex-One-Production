{
  "schemaVersion": 1,
  "service": "apex-one",
  "secretAuthorities": [
    {
      "name": "DATABASE_URL",
      "purpose": "PostgreSQL application, audit, and search authority",
      "environments": ["development", "staging", "production"],
      "rotationImpact": "database connectivity"
    },
    {
      "name": "REDIS_URL",
      "purpose": "Redis session and distributed rate-limit authority",
      "environments": ["development", "staging", "production"],
      "rotationImpact": "active sessions and rate-limit state"
    },
    {
      "name": "S3_ACCESS_KEY_ID",
      "purpose": "S3-compatible document storage credential",
      "environments": ["development", "staging", "production"],
      "rotationImpact": "document object access"
    },
    {
      "name": "S3_SECRET_ACCESS_KEY",
      "purpose": "S3-compatible document storage secret",
      "environments": ["development", "staging", "production"],
      "rotationImpact": "document object access"
    },
    {
      "name": "DOCUMENT_STORAGE_ENCRYPTION_KEY",
      "purpose": "AES-256-GCM document encryption authority",
      "environments": ["development", "staging", "production"],
      "rotationImpact": "existing ciphertext readability",
      "highValue": true
    },
    {
      "name": "GEMINI_API_KEY",
      "purpose": "Server-side Gemini generation credential",
      "environments": ["development", "staging", "production"],
      "rotationImpact": "generative AI availability"
    },
    {
      "name": "APEX_BOOTSTRAP_ADMIN_PASSWORD",
      "purpose": "One-time initial administrator credential",
      "environments": ["development", "staging"],
      "rotationImpact": "bootstrap only",
      "ephemeral": true
    },
    {
      "name": "APEX_DEPLOYMENT_CONTROL_TOKEN",
      "purpose": "Release-controller bearer credential",
      "environments": ["staging", "production"],
      "rotationImpact": "deployment control"
    }
  ],
  "nonSecretConfiguration": [
    "APP_ENV",
    "APEX_DEPLOYMENT_ENVIRONMENT",
    "APEX_DATABASE_ADAPTER",
    "APEX_SESSION_ADAPTER",
    "APEX_RATE_LIMIT_ADAPTER",
    "APEX_AUDIT_ADAPTER",
    "APEX_OBJECT_STORAGE_ADAPTER",
    "APEX_SEARCH_INDEX_ADAPTER",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ENDPOINT",
    "APEX_RELEASE_ID",
    "APEX_COMMIT_SHA",
    "APEX_IMAGE_DIGEST"
  ]
}
