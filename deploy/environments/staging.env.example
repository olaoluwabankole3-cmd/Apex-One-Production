# APEX ONE — staging environment contract
# This file contains names/placeholders only. Real values belong in the
# deployment platform's protected secret/environment store.

APP_ENV=production
DEMO_MODE=false
APEX_DEPLOYMENT_ENVIRONMENT=staging

APEX_DATABASE_ADAPTER=postgres
APEX_SESSION_ADAPTER=redis
APEX_RATE_LIMIT_ADAPTER=redis
APEX_AUDIT_ADAPTER=postgres
APEX_OBJECT_STORAGE_ADAPTER=s3
APEX_SEARCH_INDEX_ADAPTER=postgres

# Must use PostgreSQL TLS: sslmode=require or sslmode=verify-full.
DATABASE_URL=postgres://USER:PASSWORD@STAGING_POSTGRES_HOST:5432/apex_staging?sslmode=verify-full

# Must use TLS.
REDIS_URL=rediss://USER:PASSWORD@STAGING_REDIS_HOST:6380/0

S3_BUCKET=apex-staging-documents
S3_REGION=REGION
S3_ENDPOINT=https://STAGING_S3_COMPATIBLE_ENDPOINT
S3_ACCESS_KEY_ID=STAGING_SECRET
S3_SECRET_ACCESS_KEY=STAGING_SECRET

# Standard base64 encoding of exactly 32 random bytes.
DOCUMENT_STORAGE_ENCRYPTION_KEY=STAGING_SECRET

# Server-side Gemini credential.
GEMINI_API_KEY=STAGING_SECRET

# Immutable release identity is injected by the release/deployment system.
APEX_RELEASE_ID=
APEX_COMMIT_SHA=
APEX_IMAGE_DIGEST=

# One-time initial administrator bootstrap values.
# Put password and other sensitive values in protected secrets, not this file.
APEX_BOOTSTRAP_CONFIRM=
APEX_BOOTSTRAP_ORG_NAME=
APEX_BOOTSTRAP_ORG_DISPLAY_NAME=
APEX_BOOTSTRAP_ORG_SLUG=
APEX_BOOTSTRAP_ORG_INDUSTRY=
APEX_BOOTSTRAP_ORG_CURRENCY=
APEX_BOOTSTRAP_ORG_CURRENCY_SYMBOL=
APEX_BOOTSTRAP_ORG_TIMEZONE=
APEX_BOOTSTRAP_ADMIN_EMAIL=
APEX_BOOTSTRAP_ADMIN_USERNAME=
APEX_BOOTSTRAP_ADMIN_NAME=
APEX_BOOTSTRAP_ADMIN_TITLE=Administrator
APEX_BOOTSTRAP_ADMIN_PASSWORD=
